---
const destinos = [
  {
    nombre: "Riviera Maya",
    imagen: "/Cancun.webp",
    descripcion: "Playas paradisíacas, cenotes y resorts todo incluido.",
    atlas: "/Atlas/Playero/Camara.png",
    atlasAlt: "Atlas disfrutando de Riviera Maya"
  },
  {
    nombre: "Canadá",
    imagen: "/Canada.webp",
    descripcion: "Naturaleza impresionante y ciudades llenas de vida.",
    atlas: "/Atlas/Nieve/Rodilla.png",
    atlasAlt: "Atlas explorando Canadá"
  },
  {
    nombre: "Europa",
    imagen: "/Europa3.webp",
    descripcion: "Historia, cultura y destinos inolvidables.",
    atlas: "/Atlas/Turista/Caminando.png",
    atlasAlt: "Atlas explorando Europa"
  }
];
---

<section
  id="destinos"
  class="py-24 bg-[#FFF9F5]"
>

  <div class="max-w-7xl mx-auto px-6">

    <!-- TITULO -->
    <div class="text-center mb-16">

      <p class="text-pink-400 font-semibold uppercase tracking-widest">
        Destinos
      </p>

      <h2 class="text-4xl md:text-5xl font-bold text-gray-800 mt-3">
        Explora el mundo con nosotros 🌎
      </h2>

    </div>


    <!-- GRID -->
    <div class="grid md:grid-cols-3 gap-8">

      {destinos.map((destino) => (

        <div
          data-aos="zoom-in"
          class="group relative rounded-3xl overflow-hidden shadow-xl"
        >

          <!-- IMAGEN -->
          <img
            src={destino.imagen}
            alt={destino.nombre}
            class="w-full h-[450px] object-cover group-hover:scale-110 transition duration-700"
          />


          <!-- OVERLAY -->
          <div
            class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/20 to-transparent"
          ></div>


          <!-- ATLAS -->
          <img
            src={destino.atlas}
            alt={destino.atlasAlt}
            class="
              absolute
              bottom-0
              right-2
              w-32
              md:w-36
              drop-shadow-2xl
              transition-all
              duration-500
              ease-out
              group-hover:-translate-y-3
              group-hover:scale-105
              z-10
            "
          />


          <!-- TEXTO -->
          <div
            class="
              absolute
              bottom-6
              left-6
              right-28
              text-white
              z-20
            "
          >

            <h3 class="text-3xl font-bold">
              {destino.nombre}
            </h3>

            <p class="text-white/85 mt-2 text-sm md:text-base leading-relaxed">
              {destino.descripcion}
            </p>

          </div>

        </div>

      ))}

    </div>

  </div>

</section>