---

import { Instagram, Facebook, Music2 } from "lucide-astro";

---

<footer class="bg-slate-900 text-white py-12">
  <div class="max-w-6xl mx-auto px-6 grid md:grid-cols-3 gap-8">

    <div>
      <img src="/LogoClaro.png" alt="MJ Tour & Travel" class="h-30 mb-4" />
      <p class="text-slate-300">
        Creamos experiencias inolvidables para que solo te preocupes por disfrutar.
      </p>
    </div>

    <div>
      <h3 class="font-semibold text-lg mb-4">Contacto</h3>
      <ul class="space-y-2 text-slate-300">
        <li>📱 WhatsApp </li>
        <li>📍 Cancún, Quintana Roo</li>
      </ul>
    </div>

    <div>
      <h3 class="font-semibold text-lg mb-4">Síguenos</h3>

      <div class="flex gap-5 mt-4">

  <a
  href="..."
  target="_blank"
  class="w-12 h-12 bg-white/10 rounded-full flex items-center justify-center hover:bg-pink-500 transition"
    >
      <Instagram size={22} />
    </a>

  <a

    href="https://www.facebook.com/profile.php?id=61561111046840"

    target="_blank"

    class="w-12 h-12 bg-white/10 rounded-full flex items-center justify-center hover:bg-blue-500 transition"

  >

    <Facebook size={22} />

  </a>

  <a

    href="https://www.tiktok.com/@janismjtourtravel"

    target="_blank"

    class="w-12 h-12 bg-white/10 rounded-full flex items-center justify-center hover:bg-cyan-400 transition"

  >

    <Music2 size={22} />

  </a>

</div>
    </div>

  </div>

  <div class="border-t border-slate-700 mt-8 pt-6 text-center text-slate-400">
    © 2026 MJ Tour & Travel. Todos los derechos reservados.
  </div>
</footer>