---
const servicios = [
  {
    icono: "✈️",
    titulo: "Vuelos",
    descripcion: "Encontramos las mejores opciones para tu viaje."
  },

  {
    icono: "🏨",
    titulo: "Hospedaje",
    descripcion: "Hoteles y resorts para todos los estilos y presupuestos."
  },

  {
    icono: "🌎",
    titulo: "Paquetes",
    descripcion: "Experiencias completas listas para disfrutar."
  },

  {
    icono: "📞",
    titulo: "Asesoría",
    descripcion: "Te acompañamos antes, durante y después del viaje."
  }
];
---

<section
  id="servicios"
  class="py-24 bg-white"
>

  <div class="max-w-7xl mx-auto px-6">

    <!-- TITULO -->
    <div class="text-center mb-16">

      <p class="text-pink-400 uppercase tracking-widest font-semibold">
        Servicios
      </p>

      <h2 class="text-4xl md:text-5xl font-bold text-gray-800 mt-3">
        Todo lo que necesitas para viajar ✨
      </h2>

    </div>

    <!-- GRID -->
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">

      {servicios.map((servicio) => (

        <div
          data-aos="fade-up"
          class="bg-[#FFF9F5] rounded-3xl p-8 shadow-lg hover:shadow-2xl hover:-translate-y-2 transition duration-300"
        >

          <!-- ICONO -->
          <div
            class="w-16 h-16 rounded-2xl bg-pink-200 flex items-center justify-center text-3xl"
          >
            {servicio.icono}
          </div>

          <!-- TEXTO -->
          <h3 class="text-2xl font-bold text-gray-800 mt-6">
            {servicio.titulo}
          </h3>

          <p class="text-gray-500 mt-4 leading-relaxed">
            {servicio.descripcion}
          </p>

        </div>

      ))}

    </div>

  </div>

</section>