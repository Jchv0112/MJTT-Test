---
import Hero from "../components/Hero.astro";
import SobreNosotros from "../components/SobreNosotros.astro";
import Navbar from "../components/Navbar.astro";
import Destinos from "../components/Destinos.astro";
import Servicios from "../components/Servicios.astro";
import Beneficios from "../components/Beneficios.astro";
import Asesoras from "../components/Asesoras.astro";
import Footer from "../components/Footer.astro";


import "../styles/global.css";

import "aos/dist/aos.css";
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>MJ Tour & Travel</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta
          name="description"
          content="Agencia de viajes especializada en destinos nacionales e internacionales. Atención personalizada por WhatsApp."
        />
    <meta property="og:title" content="MJ Tour & Travel" />
    <meta property="og:description" content="Viajes sin preocupaciones." />
    <meta property="og:image" content="/Logo.png" />
  </head>

  <body>

    <Navbar />
    <Hero />
    <SobreNosotros />
    <Destinos />
    <Servicios />
    <Beneficios />
    <Asesoras />
    <Footer />

    <!-- BOTÓN WHATSAPP -->
<a
  href="https://wa.me/5215551371157"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Contactar a MJ Tour & Travel por WhatsApp"
  class="fixed bottom-4 right-3 sm:bottom-6 sm:right-6 z-50 flex items-end gap-1 group"
>
  <span
    id="atlas-message"
    class="mb-7 sm:mb-10
           rounded-2xl
           bg-white
           px-3 py-2 sm:px-4 sm:py-3
           text-[11px] sm:text-sm
           font-semibold
           text-gray-800
           shadow-xl
           opacity-0 translate-y-2
           transition-all duration-500
           whitespace-nowrap
           group-hover:opacity-100 group-hover:translate-y-0"
  >
    ¿Planeamos tu próximo viaje? ✈️
  </span>

  <div
    class="w-16 sm:w-20
           transition-transform duration-300
           group-hover:scale-110"
  >
    <img
      src="/Atlas/Playero/Atlas_Celular.png"
      alt="Atlas, mascota de MJ Tour & Travel"
      class="w-full h-auto"
    />
  </div>
</a>
<script>
  const message = document.getElementById("atlas-message");


  setTimeout(() => {
    message?.classList.remove("opacity-0", "translate-y-2");

    
    setTimeout(() => {
      message?.classList.add("opacity-0", "translate-y-2");
    }, 3500);
  }, 1000);
</script>

    <!-- AOS -->
  <script>
  import("aos").then((AOS) => {

    AOS.default.init({

      duration: 900,

      once: true,

    });
  });

</script>
<script>
  window.history.scrollRestoration = "manual";
  window.scrollTo(0, 0);
</script>
  </body>

</html>